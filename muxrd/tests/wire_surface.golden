rpc muxr.v1.Muxr/ListSessions (muxr.v1.Empty) returns (muxr.v1.SessionList)
rpc muxr.v1.Muxr/ListTokens (muxr.v1.Empty) returns (muxr.v1.TokenList)
rpc muxr.v1.Muxr/Login (muxr.v1.LoginRequest) returns (muxr.v1.LoginResponse)
rpc muxr.v1.Muxr/NewPane (muxr.v1.NewPaneReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/NewTab (muxr.v1.NewTabReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/RegisterPushTarget (muxr.v1.RegisterPushTargetReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/RemovePushTarget (muxr.v1.RemovePushTargetReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/RenamePane (muxr.v1.RenamePaneReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/RenameSession (muxr.v1.RenameSessionReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/RenameSpace (muxr.v1.RenameSpaceReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/RenameTab (muxr.v1.RenameTabReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/ResizePane (muxr.v1.ResizePaneReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/RevokeToken (muxr.v1.RevokeTokenReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/ScrollPane (muxr.v1.ScrollReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/SignalProcess (muxr.v1.SignalProcessRequest) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/SwitchSpace (muxr.v1.SwitchSpaceReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/TogglePaneFloating (muxr.v1.PaneTarget) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/TogglePaneFullscreen (muxr.v1.ToggleFullscreenReq) returns (muxr.v1.ActionAck)
rpc muxr.v1.Muxr/WatchAgents (muxr.v1.SessionRef) returns (stream muxr.v1.AgentEvent)
rpc muxr.v1.Muxr/WatchProcesses (muxr.v1.WatchProcessesRequest) returns (stream muxr.v1.ProcessSnapshot)
rpc muxr.v1.Muxr/WatchVitals (muxr.v1.WatchVitalsRequest) returns (stream muxr.v1.VitalsEvent)
rpc muxr.v1.Muxr/WriteToPane (muxr.v1.WriteToPaneReq) returns (muxr.v1.ActionAck)
